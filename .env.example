# Endpoint URLs; see .env for the full list. All are read through requireEnv().
NEXT_PUBLIC_BASE_URL=

# Orders (admin)
NEXT_PUBLIC_API_ADMIN_ORDER_LIST=${NEXT_PUBLIC_BASE_URL}/admin/v1/order/list
NEXT_PUBLIC_API_ADMIN_ORDER_CREATE=${NEXT_PUBLIC_BASE_URL}/admin/v1/order/create
NEXT_PUBLIC_API_ADMIN_ORDER_STATUS=${NEXT_PUBLIC_BASE_URL}/admin/v1/order/status
NEXT_PUBLIC_API_ADMIN_EMPLOYEES_BY_ROLE=${NEXT_PUBLIC_BASE_URL}/admin/v1/employees/by-role

# Multipart file upload (POST, field "file", Bearer accessToken -> { data: url })
NEXT_PUBLIC_UPLOAD_FILE=${NEXT_PUBLIC_BASE_URL}/file/v1/upload
